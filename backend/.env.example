# --- AI (optional). Leave LLM_API_KEY empty to use the built-in offline planner. ---
# Any OpenAI-compatible endpoint works. Example: Llama-3 on Groq
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# --- Supabase (optional). Leave empty to store trips in backend/data/trips.json ---
SUPABASE_URL=
SUPABASE_KEY=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
